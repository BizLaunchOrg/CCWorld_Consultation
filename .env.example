# CCWORLD Consultating – required environment variables
# Copy to .env and fill in values. Do NOT commit .env to git.

# ---- Frontend (Vite) – use in .env for local dev and in your host's env for production ----
# Supabase (from project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Site URL for auth redirects (production)
VITE_SITE_URL=https://www.ccworldconsulting.com

# Formspree: Contact Us form emails (optional – default below is used if not set)
# VITE_FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/mreybzkv

# Optional: only these emails can access /admin and /admin/login (comma-separated). If not set, any user can try; role still required.
# VITE_ADMIN_ALLOWED_EMAILS=ccworldconsulting@gmail.com

# Optional: hide admin login from the public. If set, /admin/login only works with ?t=SECRET in the URL.
# Use https://yoursite.com/admin/login?t=YourSecret to sign in; without it, /admin/login redirects to home. Keep SECRET long and random.
# VITE_ADMIN_LOGIN_SECRET=your_long_random_secret_here
