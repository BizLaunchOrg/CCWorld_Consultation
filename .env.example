# CCWORLD Consultation – required environment variables
# Copy to .env and fill in values. Do NOT commit .env to git.

# ---- Frontend (Vite) – use in .env for local dev and in your host's env for production ----
# Supabase (from project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Site URL for auth redirects and Seerbit callback (production)
VITE_SITE_URL=https://www.ccworldconsultation.com

# Optional: only these emails can access /admin and /admin/login (comma-separated). If not set, any user can try; role still required.
# VITE_ADMIN_ALLOWED_EMAILS=admin@ccworldconsultation.com,you@example.com

# ---- Edge Function secrets only (Supabase Dashboard → Edge Functions → seerbit-init → Secrets) ----
# Do NOT put SEERBIT_SECRET_KEY in frontend .env. Only in Supabase Edge Function secrets.
# SEERBIT_PUBLIC_KEY can be in frontend if needed; never expose SECRET key.
# Test keys (replace with production keys in production):
# SEERBIT_PUBLIC_KEY=SBTESTPUBK_zTKpTqocHQznsj2d6SCVopnI8xSlZZoD
# SEERBIT_SECRET_KEY=SBTESTSECK_NywnWyKaSAmoPjBUVE40i9XZPAYgtA3ZW66ALmFj
# SITE_URL=https://www.ccworldconsultation.com
# SUPABASE_ANON_KEY is auto-available in Edge Functions; if not, add for JWT validation in seerbit-init.

# ---- seerbit-webhook (payment success email via Resend) ----
# Add these in Dashboard → Edge Functions → seerbit-webhook → Secrets:
# RESEND_API_KEY=re_xxxx   (required for "We've received your payment" email)
# RESEND_FROM=notifications@yourdomain.com  (optional; default onboarding@resend.dev)
# SITE_NAME=CCworld Consulting  (optional)
